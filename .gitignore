# ---- Build outputs ----
/build/
*.o
*.a
*.elf
*.hex
*.bin
*.map
*.lst

# ---- IDE/editor ----
.vscode/
.idea/
*.swp
*~

# ---- Toolchain caches ----
.cache/

# ---- Python bytecode cache ----
__pycache__/
*.py[cod]

# ---- OS specific ----
.DS_Store
Thumbs.db

# ---- 第三方 RTOS submodules 由其自身管理 ----
# (rtos/ 下各 RTOS 是独立 git 仓库，通过 submodule 管理；其工作区修改
#  由 .gitmodules 的 ignore=dirty 过滤，不在此屏蔽)

# ---- Zephyr 外部依赖（精简模式按需拉取，属外部检出，一律不提交） ----
/rtos/zephyr/external/
/rtos/.west/
# /.venv-zephyr/ 已随 Zephyr 构建移至 build/<board>/zephyr/.venv-zephyr（/build/ 已整体忽略，无需单独规则）